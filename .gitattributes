* text=auto eol=lf

# Unity text assets
*.cs            text diff=csharp
*.meta          text
*.unity         text
*.asset         text
*.prefab        text
*.mat           text
*.inputactions  text
*.asmdef        text
*.json          text
*.md            text
*.txt           text

# Unity / web binaries
*.png           binary
*.jpg           binary
*.ico           binary
*.ttf           binary
*.otf           binary
